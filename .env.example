# Copy to .env. Never commit .env. Do not put these values in NEXT_PUBLIC_* variables.
# Browser bundles only receive NEXT_PUBLIC_API_BASE_URL.

# --- Ethereum (leave empty to run the labelled synthetic demo) ---
# Use your own mainnet endpoint. Path API keys are read server-side only.
ETH_RPC_HTTP_URL=
ETH_RPC_WS_URL=
ETH_RPC_HTTP_FALLBACK_URL=
# Hours of history to backfill on startup. 24h is about 7,200 blocks (block + receipts each).
BACKFILL_HOURS=24
RPC_MAX_CONCURRENCY=3
RPC_TIMEOUT_MS=20000

# Optional. Core gas accounting does not need these.
ETHERSCAN_API_KEY=
# Set true only if the provider supports trace_block / debug_trace and you accept the cost.
TRACE_ENABLED=false

# --- Data stores ---
DATABASE_URL=postgres://gasscope:gasscope@localhost:5432/gasscope
REDIS_URL=redis://localhost:6379

# memory = API holds a synthetic demo (no Docker). postgres = read DATABASE_URL.
# auto = postgres when DATABASE_URL is set, otherwise memory.
DATA_MODE=auto

# Worker: demo seeds synthetic history when ETH_RPC_HTTP_URL is empty.
DEMO_HOURS=12
DEMO_SEED=1559

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# Required for alert edits on any non-local deployment.
# When empty, mutations are allowed only from loopback OR when ALLOW_INSECURE_MUTATIONS=true.
INTERNAL_API_SECRET=
ALLOW_INSECURE_MUTATIONS=false
# Local docker-compose sets this true so the bundled UI can save alerts. Do not use on a public host.

# --- Optional alert delivery (server-side only) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_WEBHOOK_URL=

# --- Web ---
# Browser-reachable API origin. Not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional JSON override of the blob schedule if a newer BPO activates.
# Example: [{"name":"bpo3","time":0,"target":18,"max":24,"fraction":15000000}]
BLOB_SCHEDULE_JSON=
